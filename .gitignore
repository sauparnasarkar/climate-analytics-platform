# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.env
.venv
env/
venv/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data files — download locally, do not commit large CSVs
data/*.csv

# Area 2 normalized climate store (regenerated by `python -m pipeline.run`)
data/climate/
# Shelved sources' internal-only output (never read by the API)
data/internal/

# Weekly data-refresh artefacts — local backups + validation status marker
data/*.bak-*
data/.refresh_status
data/.refresh_row_diff

# Executed copies of the notebooks written by the data refresh (the committed notebooks carry no outputs)
data/notebook-runs/

# Local backups kept beside the agent service
services/agent/bak/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Generated artefacts — not part of the notebook template
make_*.py
.claude/settings.local.json

# Scratch folder: holds a Google OAuth client secret (never commit) and other local-only files
/tmp/

# Launchd templates rendered with real values (render.sh): never committed
deploy/launchd/rendered/
