<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ghgemissions.datarefresh__LABEL_SUFFIX__</string>
	<key>ProgramArguments</key>
	<array>
		<string>__REPO_DIR__/pipeline/ops/ghg-data-refresh.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Day</key>
		<integer>10</integer>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>__HOME__/.ghg-data-refresh/launchd.out__LABEL_SUFFIX__.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.ghg-data-refresh/launchd.err__LABEL_SUFFIX__.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>NTFY_TOPIC_FILE</key>
		<string>__NTFY_TOPIC_FILE__</string>
	</dict>
</dict>
</plist>
