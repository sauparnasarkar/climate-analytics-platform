<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ghgemissions.cloudflared__LABEL_SUFFIX__</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/bin/cloudflared</string>
		<string>tunnel</string>
		<string>--no-autoupdate</string>
		<string>run</string>
		<string>--token-file</string>
		<string>__TUNNEL_TOKEN_FILE__</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/ghgemissions-cloudflared__LABEL_SUFFIX__.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/ghgemissions-cloudflared__LABEL_SUFFIX__.error.log</string>
</dict>
</plist>
