<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ghgemissions.uvicorn__LABEL_SUFFIX__</string>
	<key>ProgramArguments</key>
	<array>
		<string>__REPO_DIR__/.venv/bin/uvicorn</string>
		<string>api.main:app</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>__API_PORT__</string>
		<string>--log-config</string>
		<string>__REPO_DIR__/uvicorn-log-config.json</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__REPO_DIR__</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/ghgemissions-uvicorn__LABEL_SUFFIX__.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/ghgemissions-uvicorn__LABEL_SUFFIX__.error.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>DEPLOY_BASE_PATH</key>
		<string>/</string>
	</dict>
</dict>
</plist>
